+                          {opt}
+                        </div>
+                      ))}
+                    </div>
+                  )}
+
+                  {showMarkingGuide && (
+                    <div className="mt-3 p-3 bg-emerald-50 border border-emerald-200 rounded-xl text-xs space-y-1">
