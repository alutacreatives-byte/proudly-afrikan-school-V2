+              </div>
+            ))}
+          </div>
+        )}
+
+        {/* Answer Key summary list */}
+        {showMarkingGuide && Array.isArray(data.answerKey) && data.answerKey.length > 0 && (
+          <div className="p-6 bg-emerald-50 border border-emerald-200 rounded-2xl space-y-3">
