+
+        <div className="space-y-4">
+          {phases.map((phase: any, idx: number) => (
+            <div key={idx} className="p-6 bg-stone-50 border border-stone-200/80 rounded-2xl space-y-2">
+              <div className="flex items-center justify-between">
